{
  "name": "@stashgg/stash-pay",
  "version": "2.1.0",
  "description": "Embeddable Stash Pay checkout SDK — React component + framework-agnostic core + script-tag UMD.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js",
      "require": "./dist/vanilla.cjs"
    },
    "./styles": "./dist/stash-pay.css",
    "./styles.css": "./dist/stash-pay.css",
    "./umd": "./dist/umd/stash-pay.umd.global.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/umd/*",
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "stash",
    "stash-pay",
    "payment",
    "checkout",
    "iframe",
    "react",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stashgg/stash-web.git"
  },
  "homepage": "https://github.com/stashgg/stash-web#readme",
  "bugs": {
    "url": "https://github.com/stashgg/stash-web/issues"
  },
  "author": "Stash",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5"
  }
}
